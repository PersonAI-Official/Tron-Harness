{
  "license": "AGPL-3.0-only",
  "name": "tron-desktop-electron",
  "version": "1.1.1",
  "private": true,
  "main": "main/index.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --dir",
    "package": "electron-builder --publish never",
    "ensure-electron": "node scripts/ensure-electron.cjs"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tron.desktop",
    "publish": null,
    "productName": "Tron",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main/**/*",
      "preload/**/*",
      "injection/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-",
      "icon": "assets/tron.icns",
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tron 使用麦克风录制语音，并通过已配置的语音识别模型转写为对话草稿。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/tron.png"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "unicode": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/tron.png",
      "category": "Utility",
      "maintainer": "Tron contributors"
    },
    "deb": {
      "recommends": [
        "libayatana-appindicator3-1",
        "gnome-shell-extension-appindicator",
        "libglib2.0-bin"
      ]
    },
    "rpm": {
      "fpm": [
        "--depends",
        "glib2",
        "--depends",
        "libsecret",
        "--rpm-tag",
        "Recommends: libayatana-appindicator-gtk3",
        "--rpm-tag",
        "Suggests: gnome-shell-extension-appindicator"
      ]
    }
  }
}
